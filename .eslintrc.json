{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": [
    "auto-imports.d.ts",
    "components.d.ts",
    "dist/",
    "src/**/*.vue",
    "src/main.js",
    "src/store/",
    "src/style/",
    "src/utils/getTime.js",
    "src/views/",
    "src/components/*.vue",
    "src/components/home/"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "varsIgnorePattern": "^[A-Z]" }]
  },
  "globals": {
    "React": true
  }
}
